# ── Database — Supabase (service role) ─────────────────────────────
# All runtime DB access goes through the Supabase JS client
# (src/lib/supabase.ts) — no Prisma, no direct Postgres connections.
# Copy both values from Supabase Dashboard → Settings → API.
# The service role key is SERVER-SIDE ONLY — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Before first run, apply the DDL (tables live in the `portal` schema,
# audit rows in `audit`):
#   1. Supabase Dashboard → SQL Editor: run sql/001_schema.sql …
#      sql/006_notifications_schema.sql in order (or psql over the session
#      pooler / direct host — see README → Database).
#   2. Supabase Dashboard → Settings → API → Exposed schemas: add
#      `portal` and `audit` (keep `public`).
#   3. Create the first admin: node scripts/create-admin.mjs <email> '<name>' '<password>'
