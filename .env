# ── Sandbox / dev runtime — SQLite ─────────────────────────────────
# The dev datasource declares only `url`, so no DIRECT_URL is needed
# while on SQLite. See .env.example for the complete template
# (including the production Supavisor strings).
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Production on Supabase — Supavisor ─────────────────────────────
# 1. Apply sql/*.sql with psql over the SESSION pooler (:5432) or the
#    direct host (db.<project-ref>.supabase.co:5432 — IPv6 / IPv4 add-on):
#      psql "$DIRECT_URL" -f sql/001_schema.sql   (… through 006)
# 2. In prisma/schema.prisma switch the datasource to provider
#    "postgresql", url = env("DATABASE_URL") and directUrl =
#    env("DIRECT_URL") — the exact block is in the schema header.
# 3. Replace the SQLite line above with the two strings below, copied
#    verbatim from Supabase Dashboard → Connect (Transaction pooler /
#    Session pooler; username is postgres.<project-ref> on both).
#    The runtime MUST go through the TRANSACTION pooler on 6543 —
#    never the direct db.<ref> host (IPv6-only, no pooling; the app
#    warns at boot if it detects it).
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   ↑ pgbouncer=true is REQUIRED (transaction mode has no prepared
#     statements — Prisma disables them). connection_limit=1 for
#     serverless / auto-scaling; 5–10 on a single dedicated server.
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#   ↑ CLI only: `prisma db push` / `prisma migrate` + psql DDL.
#     With IPv6 or the IPv4 add-on the direct host also works here:
#     postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
