// =====================================================================
// Murivest Private Capital Portal — Prisma Schema
// ---------------------------------------------------------------------
// Runtime schema for the Next.js application. The sandbox/dev runtime
// uses SQLite. For production, switch the provider to "postgresql"
// and point DATABASE_URL at your managed instance, then run
// `prisma db push` (or apply sql/001_schema.sql + 002_rls.sql first).
//
// NOTE (SQLite runtime): enums are not supported by the SQLite
// connector, so constrained fields are declared as String and enforced
// at the application layer (zod schemas in src/lib/validation.ts).
// The production PostgreSQL DDL (sql/001_schema.sql) declares the
// same constraints as native ENUM / CHECK constraints.
//
// Content objects (opportunities, briefs, data-room documents, market
// intelligence reports, landing content) are authored in Sanity and
// fetched with GROQ — they are NOT duplicated here. Local tables track
// every *interaction* with that content (saves, views, grants, access
// logs, orders) keyed by the Sanity document id.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication & identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // null => magic-link / SSO-only account
  fullName      String?
  role          String    @default("investor") // investor | advisor | admin
  status        String    @default("active") // active | suspended | locked
  emailVerifiedAt DateTime?
  mfaEnabled    Boolean   @default(false)
  mfaSecretEnc  String? // AES-256-GCM encrypted TOTP secret
  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  authTokens    AuthToken[]
  profile       InvestorProfile?
  securityEvents SecurityEvent[]
  orgMemberships OrganisationMember[]

  @@index([role])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha-256 of the opaque cookie token
  userAgent  String?
  ip         String?
  device     String? // derived friendly device label
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha-256 of the emailed link token
  purpose   String // email_verify | magic_link | password_reset
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String // login | login_failed | logout | new_device | mfa_enabled | mfa_disabled | password_changed | session_revoked | account_locked
  ip        String?
  userAgent String?
  detail    String? // JSON-encoded details
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Organisations (institutional representatives)
// ---------------------------------------------------------------------------

model Organisation {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  type        String   @default("institution") // family_office | fund | corporate | endowment | pension | other
  country     String?
  website     String?
  verified    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members OrganisationMember[]

  @@unique([name, type])
}

model OrganisationMember {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           String   @default("member") // admin | member | analyst
  title          String?
  status         String   @default("invited") // invited | active | removed
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
}

// ---------------------------------------------------------------------------
// Investor profile, verification pipeline & preferences
// ---------------------------------------------------------------------------

model InvestorProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classification   String    @default("individual") // individual | uhnwi | institutional_rep
  organisationId   String? // for institutional representatives
  jobTitle         String?
  nationality      String?
  countryResidence String?
  phone            String?

  // Deployment capacity (stated, self-reported; verified during KYC)
  capitalCurrency  String    @default("USD") // USD | KES | GBP | EUR
  equityAvailable  Float?
  totalCapacity    Float?
  capitalFloor     Float? // typical single-ticket size
  capitalCeiling   Float?

  // Progressive verification pipeline
  verificationStatus String  @default("unverified") // unverified | email_verified | profile_submitted | kyc_pending | in_review | verified | rejected
  kycStatus        String    @default("not_started") // not_started | submitted | in_review | approved | rejected
  amlStatus        String    @default("not_started") // not_started | clear | flagged
  accessTier       String    @default("tier_1") // tier_1 | tier_2 | tier_3
  ndaAccepted      Boolean   @default(false)
  onboardingStep   Int       @default(1) // last completed wizard step
  advisorId        String? // assigned Murivest advisor (User.role = advisor)
  source           String?
  notes            String?
  preferences      Json? // communication preferences: {notifyOrders, notifyMatches, notifyDocuments, notifyMessages}

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([verificationStatus])
}

model InvestorCriteria {
  id        String   @id @default(cuid())
  userId    String   @unique // one live criteria set per investor
  currency  String   @default("USD")

  // Capital
  equityAvailable Float? // deployable equity today
  totalCapacity   Float? // programme-level capacity
  minTicket       Float?
  maxTicket       Float?

  // Where & what
  geographies Json? // [{ country, city, markets: [] }]
  assetClasses Json? // ["office","industrial","retail","hospitality","mixed_use","land"]
  structures  Json? // ["direct","joint_venture","preferred_equity","debt"]

  // Return targets
  minGrossYield     Float?
  minNetYield      Float?
  targetIrr        Float?
  targetCashOnCash Float?
  targetPaybackYears Float?

  // Hold & leverage
  holdPeriodMin Float? // years
  holdPeriodMax Float?
  leverageComfort Float? // max acceptable LTV %
  financingOpen  Boolean @default(true)

  // Risk & exits
  riskTolerance String? // conservative | balanced | opportunistic | distressed
  exitPreferences Json? // ["hold_for_income","timed_sale","value_add_exit","refinance"]

  currencyNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Interaction with Sanity-sourced opportunities
// ---------------------------------------------------------------------------

model SavedOpportunity {
  id        String   @id @default(cuid())
  userId    String
  sanityId  String // Sanity opportunity document id
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, sanityId])
  @@index([userId, createdAt])
}

model OpportunityView {
  id       String   @id @default(cuid())
  userId   String
  sanityId String
  viewedAt DateTime @default(now())

  @@index([sanityId, viewedAt])
  @@index([userId, viewedAt])
}

model SavedSearch {
  id          String    @id @default(cuid())
  userId      String
  name        String
  filters     Json // Discover filter payload
  alertOnNew  Boolean   @default(false)
  lastAlertAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Investment Studio (scenarios, comparisons)
// ---------------------------------------------------------------------------

model Scenario {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  sanityOpportunityId String? // modelled opportunity (optional)
  opportunityTitle    String? // denormalised snapshot
  inputs             Json // full transparent assumption set
  summary            Json // computed metrics snapshot at save time
  notes              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Comparison {
  id          String   @id @default(cuid())
  userId      String
  name        String
  sanityIds   Json // opportunity ids compared
  scenarioIds Json // studio scenario ids included
  snapshot    Json // captured metrics for offline review
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ---------------------------------------------------------------------------
// Orders — private & institutional briefs
// ---------------------------------------------------------------------------

model Order {
  id             String   @id @default(cuid())
  reference      String   @unique // human reference e.g. MVR-ORD-7F3K2Q
  userId         String
  briefSource    String   @default("catalog") // catalog | auction | off_market | custom
  sanityBriefId  String? // Sanity brief document id (null for custom requests)
  sanityOpportunityId String? // opportunity the brief relates to (optional)
  briefTitle     String // snapshot of title at order time
  briefType      String   @default("private_brief") // private_brief | institutional_brief | custom
  format         String   @default("digital") // digital | hard_copy
  customScope    String? // requested scope for custom briefs
  amountKes      Float    @default(0)
  amountUsd      Float    @default(0)
  currency       String   @default("KES")

  status         String   @default("pending") // pending | awaiting_payment | payment_confirmed | processing | internal_review | ready | delivered | closed | cancelled
  paymentMethod  String? // mpesa | wire | card
  transactionId  String?

  // Orders Engine (admin): fulfilment assignment, advisor attribution,
  // priority, due date and secure-delivery document (Sanity id).
  assignedToId       String?
  advisorId          String? // revenue attribution
  priority           String   @default("normal") // low | normal | high | urgent
  dueAt              DateTime?
  deliveryDocumentId String? // Sanity document id delivered into the data room

  // Fulfilment snapshot
  contactName     String?
  contactEmail    String?
  organisation    String?
  shippingAddress String?
  phone           String?
  deliveryMethod  String? // secure_download | courier
  trackingNumber  String?

  cancelledAt       DateTime?
  cancellationReason String?
  deliveredAt       DateTime?
  closedAt          DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments      Payment[]
  statusEvents  OrderStatusEvent[]
  revenueEvent  RevenueEvent?
  refundAdjustments RefundAdjustment[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([assignedToId, status])
  @@index([advisorId])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  userId          String
  method          String // mpesa | wire | card
  amountKes      Float    @default(0)
  amountUsd      Float    @default(0)
  currency       String   @default("KES")
  reference      String? // transaction / confirmation code
  confirmationRaw String? // pasted M-Pesa confirmation message (for manual verification)
  status         String   @default("submitted") // submitted | verified | rejected | failed
  verifiedById   String? // advisor/admin who verified
  verifiedAt     DateTime?
  note           String?
  createdAt      DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Mandates
// ---------------------------------------------------------------------------

model Mandate {
  id                  String    @id @default(cuid())
  reference           String    @unique // MVR-MND-XXXXXX
  userId              String
  title               String
  status              String    @default("draft") // draft | submitted | active | paused | closed | rejected
  description         String?

  targetAllocationMin Float?
  targetAllocationMax Float?
  currency            String    @default("USD")
  geographies         Json?
  assetClasses        Json?
  structures          Json?
  minNetYield         Float?
  targetIrr           Float?
  holdPeriodMin       Float?
  holdPeriodMax       Float?
  leverageComfort     Float?
  riskMandate         String? // conservative | balanced | opportunistic
  exclusions          Json?

  advisorId           String?
  // Pipeline management (admin): stage, win probability, next action.
  stage              String    @default("sourcing") // sourcing | qualification | matching | negotiation | closing | post_closing
  probability        Int       @default(0) // 0-100
  nextAction         String?
  nextActionDue      DateTime?
  submittedAt         DateTime?
  activatedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  milestones MandateMilestone[]

  @@index([userId, status])
}

model MandateMilestone {
  id          String    @id @default(cuid())
  mandateId   String
  title       String
  detail      String?
  dueDate     DateTime?
  status      String    @default("pending") // pending | in_progress | done | blocked
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  mandate Mandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId])
}

// ---------------------------------------------------------------------------
// Activity & communications
// ---------------------------------------------------------------------------

model Enquiry {
  id                  String   @id @default(cuid())
  userId              String
  subject             String
  message             String
  sanityOpportunityId String? // context opportunity
  opportunityTitle    String?
  status              String   @default("open") // open | responded | closed
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  messages Message[]

  @@index([userId, createdAt])
}

model Message {
  id         String    @id @default(cuid())
  userId     String // investor thread owner
  senderType String    @default("investor") // investor | advisor | system
  senderId   String? // advisor user id when senderType = advisor
  enquiryId  String? // thread root
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  enquiry Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([enquiryId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // order_status | message | mandate | document | match | security | system
  title     String
  body      String?
  link      String? // portal path for deep-linking
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Secure data room (Sanity-sourced documents + local permissions/audit)
// ---------------------------------------------------------------------------

model DocumentGrant {
  id                String    @id @default(cuid())
  sanityDocumentId  String
  userId            String? // null when granted at organisation level
  organisationId    String?
  grantedById       String // advisor/admin who granted
  permission        String    @default("view") // view | download
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([sanityDocumentId, userId, organisationId])
}

model DocumentAccessLog {
  id                String   @id @default(cuid())
  userId            String
  sanityDocumentId  String
  documentTitle     String?
  action            String // view | download | request
  ip                String?
  userAgent         String?
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sanityDocumentId, createdAt])
}

model DocumentRequest {
  id                 String   @id @default(cuid())
  userId             String
  subject            String
  detail             String?
  sanityOpportunityId String?
  type               String   @default("data_room") // data_room | report | model | legal | custom
  status             String   @default("submitted") // submitted | in_review | ready | declined
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, status])
}

model NdaAgreement {
  id        String   @id @default(cuid())
  userId    String
  version   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([userId, version])
}

// ---------------------------------------------------------------------------
// Portfolio & capital calls
// ---------------------------------------------------------------------------

model PortfolioPosition {
  id                 String    @id @default(cuid())
  userId             String
  name              String
  sanityOpportunityId String? // origin opportunity if sourced via portal
  assetClass        String?
  geography         String?
  status            String    @default("committed") // committed | held | exited

  acquisitionDate   DateTime?
  purchasePrice     Float?
  currency          String    @default("USD")
  equityDeployed    Float?
  debtAmount        Float?
  debtRate          Float?
  debtMaturity      DateTime?

  // Latest period actuals (self-reported / advisor-maintained)
  grossIncomeAnnual Float?
  operatingExpenses Float?
  noiActual         Float?
  occupancyPct      Float?
  valuation         Float?
  valuationDate     DateTime?
  valuationBasis    String? // independent_valuation | appraisal | manager_estimate

  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  capitalCalls CapitalCall[]

  @@index([userId, status])
}

model CapitalCall {
  id         String    @id @default(cuid())
  positionId String
  label      String
  amount     Float
  currency   String    @default("USD")
  dueDate    DateTime?
  status     String    @default("scheduled") // scheduled | called | paid | waived
  calledAt   DateTime?
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  position PortfolioPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, status])
}

// ---------------------------------------------------------------------------
// Admin Internal System (sql/004_admin_schema.sql)
// ---------------------------------------------------------------------------

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  adminRole String   @default("advisor") // super_admin | ops_lead | advisor | compliance | finance | content | analyst
  title     String?
  team      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminRole, isActive])
}

model OrderStatusEvent {
  id          String    @id @default(cuid())
  orderId     String
  fromStatus  String?
  toStatus    String
  changedById String?
  note        String?
  createdAt   DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model RevenueEvent {
  id             String   @id @default(cuid())
  orderId        String   @unique
  grossKes       Float    @default(0)
  grossUsd       Float    @default(0)
  processingUsd  Float    @default(0) // payment processing cost estimate
  refundUsd      Float    @default(0) // approved refunds, cumulative
  netUsd         Float    @default(0) // gross - processing - refunds
  recognisedAt   DateTime @default(now())
  recognisedById String?
  note           String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([recognisedAt])
}

model RefundAdjustment {
  id            String    @id @default(cuid())
  orderId       String
  amountUsd     Float
  amountKes     Float    @default(0)
  reason        String
  status        String    @default("proposed") // proposed | approved | rejected | applied
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model ComplianceReview {
  id            String   @id @default(cuid())
  subjectUserId String
  reviewerId    String
  decision      String // approved | rejected | escalated | note
  notes         String?
  riskFlags     Json? // [{flag, severity, note}]
  detail        Json? // {before, after, actions}
  createdAt     DateTime @default(now())

  @@index([subjectUserId, createdAt])
}

model InternalNote {
  id         String   @id @default(cuid())
  entityType String // investor | order | mandate | opportunity | enquiry | organisation | compliance | content
  entityId   String
  authorId   String
  body       String
  visibility String   @default("staff") // staff | admins
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model ContentMeta {
  id             String   @id @default(cuid())
  contentType    String // opportunity | brief | document | report
  sanityId       String
  title          String?
  tags           Json?
  status         String   @default("live") // live | paused | archived
  featured       Boolean  @default(false)
  visibilityTier String   @default("tier_1") // governance override floor
  notes          String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([contentType, sanityId])
  @@index([contentType, status])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String   @default("general") // general | feature_flag | integration
  value       Json?
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit trail (every sensitive interaction)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorType String   @default("user") // user | advisor | admin | system
  action    String // e.g. auth.login, order.created, payment.verified, document.downloaded, permission.changed
  entity    String?
  entityId  String?
  detail    Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
